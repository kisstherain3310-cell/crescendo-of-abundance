# KAMIS Open API credentials (server-only — never expose as NEXT_PUBLIC_*)
# 발급: https://www.kamis.or.kr → 고객센터 → Open-API 이용안내
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# Optional: absolute base URL for the Netlify KAMIS proxy (usually auto-detected on Netlify).
# Local `netlify dev` default: http://localhost:8888
# KAMIS_PROXY_URL=http://localhost:8888/api/kamis/tomato
